---
import type { ArticleDetailModel } from '../../features/storefront/models';
import StoreImage from '../../features/storefront/controls/StoreImage.astro';
import ProductCard from './ProductCard.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * HYPEBEN 文章详情：封面（LCP）+ 频道 + 大标题 + 署名 + 正文（markdown-content
 * 契约类名）+ 相关品牌 + 「Shop this story」关联商品 + 推荐文章 + 分享。
 *
 * 正文 HTML 已由上游渲染并转义（renderMarkdown, html:false），直接嵌入。
 */
interface Props {
  model: ArticleDetailModel;
}

const { model } = Astro.props;
---

<article>
  <a href={model.backHref} class="text-xs uppercase tracking-widest text-faint hover:text-brand">
    &larr; 返回资讯
  </a>

  <header class="mt-6 border-b border-line pb-10">
    <a
      href={`/articles?category=${model.categorySlug}`}
      class="text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-accent hover:underline"
    >
      {model.category}
    </a>
    <h1 class="mt-3 max-w-4xl text-4xl leading-[1.12] tracking-tight text-ink sm:text-5xl lg:text-6xl" style="font-weight: var(--display-weight)">
      {model.title}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{model.excerpt}</p>
    <p class="mt-6 text-xs uppercase tracking-widest text-faint">
      {model.author}{model.date ? ` · ${model.date}` : ''}
    </p>
  </header>

  {
    model.image && (
      <div class="reveal mt-10 overflow-hidden bg-surface">
        <StoreImage image={model.image} class="aspect-[16/9] w-full object-cover" />
      </div>
    )
  }

  {/* markdown-content 是正文排式的契约类名（见 base.css），不可移除。 */}
  <div class="markdown-content mt-12" set:html={model.html} />

  {/* 分享：与商品页同一实现（Web Share API + 剪贴板兜底）。 */}
  <button
    type="button"
    data-share
    data-share-title={model.title}
    class="mt-10 hidden w-fit items-center gap-2 text-xs uppercase tracking-widest text-faint transition hover:text-brand"
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="18" cy="5" r="3" />
      <circle cx="6" cy="12" r="3" />
      <circle cx="18" cy="19" r="3" />
      <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" />
      <line x1="15.4" y1="6.5" x2="8.6" y2="10.5" />
    </svg>
    <span data-share-label>分享</span>
  </button>

  {
    model.brands.length > 0 && (
      <section class="mt-12 border-t border-line pt-8">
        <h2 class="mb-4 text-xs uppercase tracking-[0.25em] text-faint">相关品牌</h2>
        <ul class="flex flex-wrap gap-3">
          {model.brands.map((brand) => (
            <li>
              <a
                href={brand.href}
                class="inline-block border border-line px-4 py-2 text-xs uppercase tracking-widest text-muted transition-colors hover:border-brand hover:text-brand"
              >
                {brand.text}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    /* Shop this story：文章关联的在售商品。下架商品已在数据层剔除。 */
    model.products.length > 0 && (
      <section class="mt-14 border-t border-line pt-12">
        <div class="mb-8 flex items-baseline justify-between border-b border-line pb-3">
          <h2 class="text-xs font-medium uppercase tracking-[0.25em] text-ink">Shop this story</h2>
          <a href="/products" class="text-xs uppercase tracking-widest text-faint hover:text-brand">进入商城 →</a>
        </div>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4">
          {model.products.map((card, i) => (
            <ProductCard card={card} index={i} headingLevel="h3" />
          ))}
        </ul>
      </section>
    )
  }

  {
    model.related.length > 0 && (
      <section class="mt-20 border-t border-line pt-12">
        <div class="mb-8 flex items-baseline justify-between border-b border-line pb-3">
          <h2 class="text-xs font-medium uppercase tracking-[0.25em] text-ink">推荐阅读</h2>
          <a href="/articles" class="text-xs uppercase tracking-widest text-faint hover:text-brand">全部资讯 →</a>
        </div>
        <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {model.related.map((card, i) => (
            <li class="reveal group" style={`animation-delay:${Math.min(i, 8) * 60}ms`}>
              <a href={card.href} class="block">
                <p class="text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-accent">
                  {card.category}
                </p>
                <h3 class="mt-2 text-lg font-medium leading-snug tracking-tight text-ink group-hover:underline">
                  {card.title}
                </h3>
                <p class="mt-2 line-clamp-2 text-sm text-muted">{card.excerpt}</p>
                <p class="mt-3 text-xs text-faint">
                  {card.author}{card.date ? ` · ${card.date}` : ''}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>
