---
import type { ArticlesListModel } from '../../features/storefront/models';
import StoreImage from '../../features/storefront/controls/StoreImage.astro';
import CatalogPagination from '../../features/storefront/controls/CatalogPagination.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * HYPEBEN 资讯中心列表页：频道 chips（含计数）+ 头条大图 + 文章网格 + 分页。
 * 模型已解析全部 URL/日期/频道标签；本组件只决定排版。
 */
interface Props {
  model: ArticlesListModel;
}

const { model } = Astro.props;
---

<div class="mb-10 border-b border-line pb-8">
  <p class="text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-accent">DISCOVER</p>
  <h1 class="mt-3 text-4xl tracking-tight text-ink sm:text-5xl" style="font-weight: var(--display-weight)">
    {model.currentCategoryLabel ?? '资讯中心'}
  </h1>
  {
    model.currentCategory && (
      <p class="mt-3 text-sm text-muted">
        {model.categories.find((c) => c.slug === model.currentCategory)?.blurb ?? ''}
        <a href="/articles" class="ml-3 text-xs uppercase tracking-widest text-faint hover:text-brand">查看全部 →</a>
      </p>
    )
  }
</div>

{/* 频道 chips：全部 + 各频道（含计数）。 */}
<div class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest">
  <a
    href="/articles"
    class={`border-b pb-0.5 ${model.currentCategory === null ? 'border-brand text-brand' : 'border-transparent text-muted hover:border-brand hover:text-brand'}`}
    aria-current={model.currentCategory === null ? 'page' : undefined}
  >
    全部
  </a>
  {model.categories.map((category) => (
    <a
      href={category.href}
      class={`border-b pb-0.5 ${category.current ? 'border-brand text-brand' : 'border-transparent text-muted hover:border-brand hover:text-brand'}`}
      aria-current={category.current ? 'page' : undefined}
    >
      {category.label}
      <span class="ml-1 text-faint">{category.count}</span>
    </a>
  ))}
</div>

{
  model.total === 0 && (
    <p role="status" class="text-muted">
      暂无资讯。
    </p>
  )
}

{
  model.lead && (
    /* 头条：仅无频道筛选时出现。 */
    <section class="reveal mb-16 border-b border-line pb-14">
      <a href={model.lead.href} class="group grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div class="relative overflow-hidden bg-surface">
          {model.lead.image ? (
            <StoreImage
              image={model.lead.image}
              class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
          ) : (
            <div class="aspect-[4/3] w-full bg-surface" aria-hidden="true" />
          )}
        </div>
        <div>
          <p class="text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-accent">
            {model.lead.category}
          </p>
          <h2 class="mt-3 text-3xl leading-[1.1] tracking-tight text-ink sm:text-4xl lg:text-5xl" style="font-weight: var(--display-weight)">
            {model.lead.title}
          </h2>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">{model.lead.excerpt}</p>
          <p class="mt-6 text-xs uppercase tracking-widest text-faint">
            {model.lead.author}{model.lead.date ? ` · ${model.lead.date}` : ''}
          </p>
        </div>
      </a>
    </section>
  )
}

{
  model.articles.length > 0 && (
    <ul class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {model.articles.map((card, i) => (
        <li class="reveal group" style={`animation-delay:${Math.min(i, 8) * 60}ms`}>
          <a href={card.href} class="block">
            <div class="relative overflow-hidden bg-surface">
              {card.image ? (
                <StoreImage
                  image={card.image}
                  fade
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                />
              ) : (
                <div class="aspect-[4/3] w-full bg-surface" aria-hidden="true" />
              )}
            </div>
            <p class="mt-4 text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-accent">
              {card.category}
            </p>
            <h3 class="mt-2 text-lg font-medium leading-snug tracking-tight text-ink group-hover:underline">
              {card.title}
            </h3>
            <p class="mt-2 line-clamp-2 text-sm text-muted">{card.excerpt}</p>
            <p class="mt-3 text-xs text-faint">
              {card.author}{card.date ? ` · ${card.date}` : ''}
            </p>
          </a>
        </li>
      ))}
    </ul>
  )
}

<CatalogPagination model={model.pagination} />
