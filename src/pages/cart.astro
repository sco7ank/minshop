---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { formatPrice } from '../config';
import { readCart, resolveCart } from '../features/cart/cart';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { stripeDestination } from '../features/shipping/destination';
import ProductImage from '../features/products/ProductImage.astro';
import { enabledMethods, isMethodAvailable } from '../features/payments';
import { catalogPath } from '../features/settings/home';

// Cart switched off in Settings → browse-only catalog, no cart page.
if (!(Astro.locals.settings?.cartEnabled ?? true)) return Astro.redirect('/', 302);

// Show only the methods that can actually take a payment right now — the
// configured real rails plus the always-on demo, minus any the admin disabled.
// A fresh deploy with no payment secrets therefore offers demo only; adding a
// rail's keys makes its button appear automatically (no unconfigured "set this
// up" buttons facing customers). The first method gets the primary styling.
const settings = Astro.locals.settings;
const methods = settings ? enabledMethods(settings) : [];
const ready = (m: string) => m === "demo" || (!!settings && isMethodAvailable(m as never, settings));
const firstReady = methods.find(ready);
const methodRows = methods.map((m) => ({ m, ready: ready(m), primary: m === firstReady }));
const METHOD: Record<string, { label: string; hint: string; setupHint: string }> = {
  stripe: { label: '银行卡支付', hint: 'Visa、Mastercard、Apple Pay 等', setupHint: '配置银行卡支付' },
  lightning: { label: 'Lightning 支付 ⚡', hint: '即时到账 — 支持任意 Lightning 钱包', setupHint: '配置 Lightning' },
  opennode: { label: 'Bitcoin 支付', hint: '链上或 Lightning（OpenNode）', setupHint: '配置 OpenNode' },
  demo: { label: '演示结账', hint: '模拟下单 — 生成真实测试订单，不扣款', setupHint: '' },
};

const cart = readCart(Astro.cookies);
const { lines, subtotalCents } = await resolveCart(env.DB, cart);
const error = Astro.url.searchParams.get('error');

// Destination pre-selector for Stripe's hosted checkout: Stripe shows a static
// rate list set before it knows the address, so let the shopper pick the country
// here (defaulted to the first, editable) → Stripe gets that zone's rates. The
// in-app rails collect the address on /checkout, so the selector appears exactly
// when Stripe is offered at all — not only when it happens to be the default.
// Effective configuration, not `cfg.shipping` — a saved Admin document owns both
// the zones and the on/off switch. An all-digital cart never needs a destination,
// so the selector is also gated on some line actually requiring shipping.
const effectiveShipping = shippingFor(settings).config;
const destination = stripeDestination(
  settings,
  effectiveShipping,
  shipmentWeightFor(lines).shippingRequired,
  Astro.request.headers.get('cf-ipcountry'),
);
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title="购物袋">
  <h1 class="mb-10 font-serif text-4xl tracking-tight">购物袋</h1>

  {
    error && (
      <p class="mb-8 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        {error}
      </p>
    )
  }

  {
    lines.length === 0 ? (
      <p class="text-muted">
        购物袋是空的。{' '}
        <a href={shopHref} class="border-b border-brand text-brand">
          去逛逛
        </a>
        。
      </p>
    ) : (
      <Fragment>
        {/* Items — a reflowing list (not a rigid table) so it works on mobile:
            product takes the row, the qty/total/remove controls wrap below on
            narrow screens. */}
        <ul class="border-t border-line">
          {lines.map((l) => (
            <li class="flex flex-wrap items-center gap-x-4 gap-y-3 border-b border-line py-4">
              <a
                href={`/products/${l.product.slug}`}
                class="flex min-w-0 flex-1 basis-64 items-center gap-4 hover:text-brand"
              >
                <ProductImage
                  imageKey={l.product.image_key}
                  alt=""
                  usage="thumbnail"
                  fade
                  sizes="64px"
                  class="h-16 w-16 shrink-0 rounded object-cover"
                />
                <span class="min-w-0">
                  <span class="block truncate">{l.product.name}</span>
                  {(l.variant || l.extras.length > 0) && (
                    <span class="block truncate text-xs text-muted">
                      {[l.variant?.label, ...l.extras.map((e) => e.label)].filter(Boolean).join(' · ')}
                    </span>
                  )}
                  <span class="block text-xs tabular-nums text-muted">
                    {formatPrice(l.unitPriceCents)} / 件
                  </span>
                  {l.availableStock <= 0 ? (
                    <span class="mt-1 block text-xs uppercase tracking-widest text-red-600">
                      已售罄
                    </span>
                  ) : l.qty > l.availableStock ? (
                    <span class="mt-1 block text-xs text-amber-700">
                      仅剩 {l.availableStock} 件
                    </span>
                  ) : null}
                </span>
              </a>

              <div class="ml-auto flex items-center gap-4">
                <form method="POST" action="/api/cart" class="flex items-center gap-2">
                  <input type="hidden" name="_action" value="update" />
                  <input type="hidden" name="key" value={l.key} />
                  <input
                    type="number"
                    name="qty"
                    min="0"
                    max="99"
                    value={l.qty}
                    aria-label="数量"
                    class="w-14 border-b border-line bg-transparent py-1 text-center tabular-nums focus:border-brand focus:outline-none"
                  />
                  <button
                    type="submit"
                    class="text-xs uppercase tracking-widest text-faint hover:text-brand"
                  >
                    更新
                  </button>
                </form>
                <span class="w-20 text-right tabular-nums">{formatPrice(l.lineTotalCents)}</span>
                <form method="POST" action="/api/cart" class="flex items-center">
                  <input type="hidden" name="_action" value="remove" />
                  <input type="hidden" name="key" value={l.key} />
                  <button
                    type="submit"
                    aria-label="移除"
                    class="text-xs uppercase tracking-widest text-faint hover:text-red-600"
                  >
                    移除
                  </button>
                </form>
              </div>
            </li>
          ))}
        </ul>

        {/* Checkout panel — full-width on mobile, right-aligned card on desktop.
            Subtotal on top, payment methods stacked beneath it. */}
        <div class="mt-10 flex justify-end">
          <div class="w-full sm:max-w-sm">
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-widest text-muted">小计</span>
              <span class="text-lg tabular-nums">{formatPrice(subtotalCents)}</span>
            </div>

            {methods.length === 0 ? (
              <p class="mt-4 rounded-lg border border-dashed border-line px-5 py-4 text-center text-sm text-muted">
                结账暂时不可用。
              </p>
            ) : (
            <form method="POST" action="/api/checkout" class="mt-4 space-y-2">
              <input type="hidden" name="source" value="cart" />
              {destination.showSelect && (
                <label class="mb-2 flex items-center justify-between gap-2 text-xs uppercase tracking-widest text-muted">
                  配送至
                  <select
                    name="country"
                    class="rounded-md border border-line px-2 py-1.5 text-sm normal-case tracking-normal text-ink"
                  >
                    {destination.countries.map((c) => (
                      <option value={c} selected={c === destination.defaultCountry}>
                        {destination.label(c)}
                      </option>
                    ))}
                  </select>
                </label>
              )}
              {/* One choice must STILL be submitted: with the field absent the
                  server falls back to the raw first zone, which may be exactly the
                  Stripe-unsupported country the filter removed. */}
              {destination.hiddenOnly && (
                <input type="hidden" name="country" value={destination.countries[0]} />
              )}

              {/* One control per offered method. Ready (configured/demo) → a submit
                  whose name/value sends method=<rail>. Unconfigured real rails → a
                  link to setup instructions (a dashed, muted "set this up" tile). */}
              {methodRows.map(({ m, ready, primary }) =>
                ready ? (
                  <button
                    type="submit"
                    name="method"
                    value={m}
                    class={`flex w-full items-center justify-between gap-3 rounded-lg px-5 py-3 text-left transition ${
                      primary
                        ? 'bg-brand text-on-brand hover:bg-brand-hover'
                        : 'border border-line text-muted hover:border-brand'
                    }`}
                  >
                    <span>
                      <span class="block text-sm font-medium">{METHOD[m]?.label ?? m}</span>
                      <span class={`block text-xs ${primary ? 'text-on-brand/70' : 'text-muted'}`}>
                        {METHOD[m]?.hint ?? ''}
                      </span>
                    </span>
                    <span aria-hidden="true" class={primary ? 'text-on-brand/80' : 'text-faint'}>
                      &rarr;
                    </span>
                  </button>
                ) : (
                  <a
                    href={`/payment-setup?method=${m}`}
                    class="flex w-full items-center justify-between gap-3 rounded-lg border border-dashed border-line px-5 py-3 text-left text-faint transition hover:border-brand hover:text-brand"
                  >
                    <span>
                      <span class="block text-sm font-medium">{METHOD[m]?.label ?? m}</span>
                      <span class="block text-xs">{METHOD[m]?.setupHint ?? 'Set up'}</span>
                    </span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                ),
              )}
            </form>
            )}
          </div>
        </div>
      </Fragment>
    )
  }
</Layout>
