---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

// Reached from the cart when a buyer taps a payment method that isn't configured
// yet. It's owner-facing setup help — how to turn that rail on — so the store can
// graduate from Demo to real payments without leaving a dead button.
const method = (Astro.url.searchParams.get('method') ?? '').toLowerCase();
const origin = Astro.url.origin;

interface Guide {
  title: string;
  intro: string;
  steps: string[];
}
const GUIDES: Record<string, Guide> = {
  stripe: {
    title: '配置银行卡支付（Stripe）',
    intro: '通过 Stripe Checkout 接受 Visa、Mastercard、Apple Pay 等银行卡支付。',
    steps: [
      '注册 Stripe 账户，在 dashboard.stripe.com/apikeys 获取 Secret key。',
      '粘贴到 后台 → 设置 → 支付密钥（Stripe secret key）。密钥以加密形式存储在数据库中。',
      `在 Stripe 中添加 Webhook 端点 ${origin}/api/webhook/stripe（事件：checkout.session.completed、checkout.session.async_payment_succeeded 与 charge.refunded——最后一个用于把你在 Stripe 后台操作的退款同步回订单）。`,
      '把给出的签名密钥粘贴到 支付密钥（Stripe webhook signing secret）。银行卡按钮会自动上线。',
    ],
  },
  lightning: {
    title: '配置 Lightning 支付',
    intro: '接受来自任意钱包的即时 Bitcoin Lightning 支付。',
    steps: [
      '搭建一个 LNbits 实例（或 phoenixd 节点）。',
      '在 后台 → 设置 → 支付 中，把默认支付渠道设为 Lightning，并选择节点（LNbits 或 phoenixd）。',
      '在 支付配置 中填写节点 URL，在 支付密钥 中填写密钥（LNbits 的 invoice/read key，或 phoenixd 密码）。Lightning 按钮会自动上线。',
    ],
  },
  opennode: {
    title: '配置 Bitcoin 支付（OpenNode）',
    intro: '通过 OpenNode 使用托管的链上 + Lightning 结账。',
    steps: [
      '注册 OpenNode 账户并创建 API key。',
      '粘贴到 后台 → 设置 → 支付密钥（OpenNode API key）。',
      `将其 Webhook 指向 ${origin}/api/webhook/opennode，并在 设置 → 支付 中把默认渠道设为 OpenNode。`,
    ],
  },
};
const guide = GUIDES[method] ?? null;
---

<Layout title="配置支付" description="如何启用一种支付方式。">
  <div class="mx-auto max-w-xl py-8">
    <a href="/cart" class="text-xs uppercase tracking-widest text-faint hover:text-brand">
      &larr; 返回购物袋
    </a>

    {
      guide ? (
        <>
          <h1 class="mt-4 font-serif text-3xl tracking-tight">{guide.title}</h1>
          <p class="mt-3 text-muted">{guide.intro}</p>
          <ol class="mt-6 space-y-3">
            {guide.steps.map((s, i) => (
              <li class="flex gap-3 text-sm">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand/10 text-xs font-medium text-brand">
                  {i + 1}
                </span>
                <span class="pt-0.5 text-muted">{s}</span>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <h1 class="mt-4 font-serif text-3xl tracking-tight">配置支付</h1>
          <p class="mt-3 text-muted">
            该支付方式尚未配置。请在 后台 → 设置 → 支付 中添加一个真实渠道（银行卡或 Lightning），或继续使用演示结账体验商店。
          </p>
        </>
      )
    }

    <div class="mt-8 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      在此期间，<strong class="font-semibold">演示结账</strong>立即可用——它会生成一笔标记为 demo 的真实订单，让你在不向任何人扣款的情况下体验完整流程。
    </div>
  </div>
</Layout>
