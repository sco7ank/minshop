---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import HomeFeed from '../features/storefront/HomeFeed.astro';
import { resolveHomePath } from '../features/settings/home';

/**
 * HYPEBEN 首页（DISCOVER 模式）：编辑部 × 商城融合。
 *
 * 商户仍可用 homePage 设置把 `/` 指向某个页面或单品（rewrite 保留原逻辑）；
 * 未设置时渲染编辑部首页，商城目录固定位于 `/products`。
 */
const homePath = await resolveHomePath(env.DB, Astro.locals.settings?.homePage);
if (homePath) return Astro.rewrite(homePath);
---

<Layout title="首页">
  <HomeFeed />
</Layout>
