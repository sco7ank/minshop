---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="新建品牌" active="brands">
  <a href="/admin/brands" class="text-sm text-gray-500 hover:text-brand">&larr; 返回品牌列表</a>
  <h1 class="mt-4 mb-6 font-serif text-3xl tracking-tight">新建品牌</h1>

  {
    error && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {error}
      </p>
    )
  }

  {/* Step one of two: this creates the brand row and redirects to the editor.
      Logo and linked products can only be attached to a brand that has an id. */}
  <form method="POST" action="/api/admin/brands" class="max-w-xl">
    <label class="block text-xs uppercase tracking-widest text-gray-400">
      品牌名
      <input
        type="text"
        name="name"
        required
        maxlength="60"
        autofocus
        class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
      />
    </label>

    <label class="mt-4 block text-xs uppercase tracking-widest text-gray-400">
      URL 别名 <span class="normal-case tracking-normal text-gray-400">（选填）</span>
      <input
        type="text"
        name="slug"
        placeholder="stone-island"
        class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
      />
      <span class="mt-1 block normal-case tracking-normal text-gray-400">
        留空则根据品牌名自动生成。品牌页将发布在 /brands/&lt;别名&gt;。
      </span>
    </label>

    <button
      type="submit"
      class="mt-6 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      创建品牌
    </button>
  </form>
</AdminLayout>
