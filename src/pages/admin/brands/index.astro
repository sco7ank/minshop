---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { brandContentCounts, listBrands } from '../../../features/brands/db';

const [brands, counts] = await Promise.all([listBrands(env.DB), brandContentCounts(env.DB)]);
---

<AdminLayout title="品牌" active="brands">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-serif text-3xl tracking-tight">品牌</h1>
    <a
      href="/admin/brands/new"
      class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      新建品牌
    </a>
  </div>

  {
    brands.length === 0 ? (
      <p class="py-12 text-center text-sm text-gray-500">
        还没有品牌。建一个品牌，把商品归到它的名下——品牌页会展示介绍、相关报道与在售商品。
      </p>
    ) : (
      <div class="sm:overflow-x-auto">
        <table class="admin-table w-full text-left text-sm sm:min-w-[40rem]">
          <thead>
            <tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
              <th class="py-3 pr-4 font-normal">品牌</th>
              <th class="py-3 pr-4 font-normal">状态</th>
              <th class="py-3 pr-4 font-normal">内容</th>
              <th class="py-3 text-right font-normal">操作</th>
            </tr>
          </thead>
          <tbody>
            {brands.map((brand) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-4">
                  <a href={`/admin/brands/${brand.public_id}/edit`} class="font-medium hover:text-brand">
                    {brand.name}
                  </a>
                  <span class="ml-2 text-xs text-gray-400">/{brand.slug}</span>
                </td>
                <td data-label="状态" class="py-3 pr-4">
                  {brand.published ? (
                    <span class="text-gray-600">已发布</span>
                  ) : (
                    <span class="text-gray-400">草稿</span>
                  )}
                </td>
                <td data-label="内容" class="py-3 pr-4 text-gray-500">
                  {counts.products.get(brand.id) ?? 0} 件商品 · {counts.articles.get(brand.id) ?? 0} 篇报道
                </td>
                <td class="py-3 text-right">
                  <span class="inline-flex items-center gap-3">
                    {brand.published !== 0 && (
                      <a
                        href={`/brands/${brand.slug}`}
                        target="_blank"
                        rel="noopener"
                        class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                      >
                        查看
                      </a>
                    )}
                    <a
                      href={`/admin/brands/${brand.public_id}/edit`}
                      class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                    >
                      编辑
                    </a>
                    <form
                      method="POST"
                      action={`/api/admin/brands/${brand.public_id}`}
                      onsubmit="return confirm('删除这个品牌？商品关联会一并解除，商品本身保留。')"
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="text-xs uppercase tracking-widest text-red-600 hover:text-red-700"
                      >
                        删除
                      </button>
                    </form>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
