---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listArticles } from '../../../features/articles/db';
import { articleCategoryLabel } from '../../../features/articles/taxonomy';

const articles = await listArticles(env.DB);
const dateFmt = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' });
const formatDate = (iso: string) => {
  const parsed = new Date(`${iso.replace(' ', 'T')}Z`);
  return Number.isNaN(parsed.getTime()) ? iso : dateFmt.format(parsed);
};
---

<AdminLayout title="文章" active="articles">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-serif text-3xl tracking-tight">文章</h1>
    <a
      href="/admin/articles/new"
      class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      新建文章
    </a>
  </div>

  {
    articles.length === 0 ? (
      <p class="py-12 text-center text-sm text-gray-500">
        还没有文章。写一篇发布到{' '}
        <a href="/articles" class="underline hover:text-brand">资讯中心</a>{' '}
        ——可关联相关商品与品牌，把内容变成购买入口。
      </p>
    ) : (
      <div class="sm:overflow-x-auto">
        <table class="admin-table w-full text-left text-sm sm:min-w-[40rem]">
          <thead>
            <tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
              <th class="py-3 pr-4 font-normal">标题</th>
              <th class="py-3 pr-4 font-normal">频道</th>
              <th class="py-3 pr-4 font-normal">状态</th>
              <th class="py-3 pr-4 font-normal">更新</th>
              <th class="py-3 text-right font-normal">操作</th>
            </tr>
          </thead>
          <tbody>
            {articles.map((article) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-4">
                  <a href={`/admin/articles/${article.public_id}/edit`} class="font-medium hover:text-brand">
                    {article.title}
                  </a>
                  {article.featured === 1 && (
                    <span class="ml-2 rounded bg-brand/10 px-1.5 py-0.5 text-xs text-brand">精选</span>
                  )}
                </td>
                <td data-label="频道" class="py-3 pr-4 text-gray-500">{articleCategoryLabel(article.category)}</td>
                <td data-label="状态" class="py-3 pr-4">
                  {article.published ? (
                    <span class="text-gray-600">已发布</span>
                  ) : (
                    <span class="text-gray-400">草稿</span>
                  )}
                </td>
                <td data-label="更新" class="py-3 pr-4 text-gray-500">
                  {formatDate(article.updated_at)}
                </td>
                <td class="py-3 text-right">
                  <span class="inline-flex items-center gap-3">
                    {article.published !== 0 && (
                      <a
                        href={`/articles/${article.slug}`}
                        target="_blank"
                        rel="noopener"
                        class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                      >
                        查看
                      </a>
                    )}
                    <a
                      href={`/admin/articles/${article.public_id}/edit`}
                      class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                    >
                      编辑
                    </a>
                    <form
                      method="POST"
                      action={`/api/admin/articles/${article.public_id}`}
                      onsubmit="return confirm('删除这篇文章？关联会一并解除，媒体文件保留。')"
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="text-xs uppercase tracking-widest text-red-600 hover:text-red-700"
                      >
                        删除
                      </button>
                    </form>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
