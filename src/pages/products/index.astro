---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import ProductList from '../../features/products/ProductList.astro';
import { publicOrigin } from '../../features/http/origin';

/**
 * The catalog's own URL.
 *
 * HYPEBEN: `/` is the DISCOVER editorial home, so the catalog lives here and
 * only here — no canonical juggling against `/`, and the header's 商城 mode
 * links straight to this address.
 */
const canonical = new URL('/products', publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN)).href;
---

<Layout title="全部商品" canonical={canonical}>
  <ProductList eyebrow="商城" heading="全部商品" />
</Layout>
