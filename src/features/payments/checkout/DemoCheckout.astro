---
import { getConfig, formatPrice } from '../../../config';
import type { PendingPayment } from '../lightning/pending';

// Simulated checkout view. Rendered by /pay/[publicId] for demo-backed payments.
// The form posts back to that same route, which calls settleDemoCheckout().
interface Props {
  pending: PendingPayment;
  declined?: string | null;
}
const { pending, declined = null } = Astro.props;

const OUTCOMES: Record<string, string> = {
  approve: '批准付款',
  decline: '拒绝 — 银行卡被拒',
  insufficient: '拒绝 — 余额不足',
};
const { storeName } = getConfig();
const total = formatPrice(pending.amount_total_cents, pending.currency);
const shipping = pending.shipping_cents
  ? formatPrice(pending.shipping_cents, pending.currency)
  : null;

// Parse the cart snapshot for a line summary (same shape checkout stored).
type Snap = { id: number; q: number; n: string; p: number };
let items: Snap[] = [];
try {
  items = pending.items ? (JSON.parse(pending.items) as Snap[]) : [];
} catch {
  items = [];
}
---

<div class="mx-auto max-w-md">
  <div class="mb-6 rounded-lg border-2 border-amber-400 bg-amber-50 px-4 py-4 text-center text-amber-900">
    <p class="text-base font-bold uppercase tracking-wide">⚠️ 演示结账 — 非真实支付</p>
    <p class="mt-1 text-sm">
      不会扣款。提交后会生成一笔标记为
      <code class="rounded bg-amber-100 px-1">demo</code> 的真实订单，方便你体验完整流程。
    </p>
  </div>

  <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">结账</h1>
  <p class="mb-6 text-sm text-muted">{storeName}</p>

  {/* Order summary */}
  <div class="mb-6 rounded-lg border border-line bg-surface p-4">
    <ul class="divide-y divide-line text-sm">
      {items.map((it) => (
        <li class="flex items-center justify-between gap-3 py-2">
          <span class="min-w-0 truncate">
            {it.n} <span class="text-faint">× {it.q}</span>
          </span>
          <span class="shrink-0 tabular-nums">{formatPrice(it.p * it.q, pending.currency)}</span>
        </li>
      ))}
    </ul>
    {shipping && (
      <div class="flex items-center justify-between border-t border-line pt-2 text-sm text-muted">
        <span>运费</span>
        <span class="tabular-nums">{shipping}</span>
      </div>
    )}
    <div class="mt-2 flex items-center justify-between border-t border-line pt-2 text-base font-medium">
      <span>合计</span>
      <span class="tabular-nums">{total}</span>
    </div>
  </div>

  {declined && (
    <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
      {declined}
    </p>
  )}

  <form method="POST" class="space-y-4">
    {/* Demo skips the address step (checkout.astro auto-submits a sample
        address), so this is the shopper's only chance to set an email —
        prefilled with the sample, editable for anyone who wants the receipt
        for real. Settlement prefers the submitted value
        (resolveRequiredOrderEmail). */}
    <div>
      <label class="mb-1 block text-xs font-medium text-muted" for="email">
        接收订单确认邮件的邮箱
      </label>
      <input
        id="email"
        name="email"
        type="email"
        value={pending.email ?? ''}
        autocomplete="email"
        required
        class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
      />
    </div>

    {/* Decorative test-card fields — prefilled and ignored; they exist so the
        flow looks like a real card form. */}
    <fieldset class="rounded-lg border border-line p-3">
      <legend class="px-1 text-xs font-medium text-muted">银行卡（测试 — 内容不参与校验）</legend>
      <input
        type="text"
        value="4242 4242 4242 4242"
        inputmode="numeric"
        aria-label="卡号"
        class="mb-2 w-full rounded-md border border-line px-3 py-2 font-mono text-sm text-muted"
      />
      <div class="flex gap-2">
        <input
          type="text"
          value="12 / 34"
          aria-label="有效期"
          class="w-1/2 rounded-md border border-line px-3 py-2 font-mono text-sm text-muted"
        />
        <input
          type="text"
          value="123"
          aria-label="安全码"
          class="w-1/2 rounded-md border border-line px-3 py-2 font-mono text-sm text-muted"
        />
      </div>
    </fieldset>

    <div>
      <label class="mb-1 block text-xs font-medium text-muted" for="outcome">
        模拟结果
      </label>
      <select
        id="outcome"
        name="outcome"
        class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
      >
        {Object.entries(OUTCOMES).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </div>

    <button
      type="submit"
      class="w-full rounded-md bg-brand px-5 py-3 text-sm font-medium uppercase tracking-wider text-on-brand hover:bg-brand-hover"
    >
      支付 {total}
    </button>
    <a href="/cart" class="block text-center text-xs uppercase tracking-widest text-faint hover:text-brand">
      取消
    </a>
  </form>
</div>
